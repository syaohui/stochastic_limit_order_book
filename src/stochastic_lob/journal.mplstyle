# Journal figure style, sized for print.
# Adapted from SciencePlots (github.com/garrettj403/SciencePlots) with larger
# type and a framed legend. Mathtext renders the math, so no LaTeX install is needed.

axes.prop_cycle : cycler('color', ['0C5DA5', 'FF2C00', '00B945', 'FF9500', '845B97', '474747', '9e9e9e'])

figure.figsize   : 3.5, 2.625
figure.dpi       : 150
savefig.dpi      : 600
savefig.bbox     : tight
savefig.pad_inches : 0.02
savefig.transparent : False

xtick.direction     : in
xtick.top           : True
xtick.minor.visible : True
xtick.major.size    : 3.5
xtick.major.width   : 0.7
xtick.minor.size    : 2.0
xtick.minor.width   : 0.6

ytick.direction     : in
ytick.right         : True
ytick.minor.visible : True
ytick.major.size    : 3.5
ytick.major.width   : 0.7
ytick.minor.size    : 2.0
ytick.minor.width   : 0.6

font.family      : serif
font.serif       : Times New Roman, DejaVu Serif, STIXGeneral
mathtext.fontset : stix
font.size        : 9
axes.labelsize   : 10
axes.titlesize   : 10
xtick.labelsize  : 9
ytick.labelsize  : 9
legend.fontsize  : 8.5
figure.labelsize : 10

axes.linewidth  : 0.7
lines.linewidth : 1.3
lines.markersize : 4
grid.linewidth  : 0.5
patch.linewidth : 0.7

legend.frameon     : True
legend.framealpha  : 0.9
legend.edgecolor   : 0.4
legend.fancybox    : False
legend.borderpad   : 0.4
legend.labelspacing : 0.3
legend.handlelength : 1.6
legend.handletextpad : 0.5
legend.borderaxespad : 0.5
legend.columnspacing : 1.2

axes.grid       : False
axes.axisbelow  : True
errorbar.capsize : 2
